+def find_user(username):
+    # Look up a user by name.
+    conn = get_connection()
+    cur = conn.cursor()
+    # SECURITY: username is interpolated directly into the SQL string.
+    query = "SELECT * FROM users WHERE name = '" + username + "'"
+    cur.execute(query)
+    return cur.fetchone()
+
+
+def average_score(scores):
+    # BUG: divides by len(scores) without guarding against an empty list,
+    # so calling average_score([]) raises ZeroDivisionError.
+    total = 0
+    for s in scores:
+        total += s
+    return total / len(scores)
+
+
+def hash_password(password):
+    # WEAK CRYPTO: unsalted MD5 is unsuitable for password hashing.
+    return hashlib.md5(password.encode()).hexdigest()
