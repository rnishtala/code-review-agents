# Local Ollama model used by every agent. Default runs comfortably on an 8 GB MacBook Air.
# Upgrade to qwen2.5-coder:7b on 16 GB+ for higher quality, or llama3.2:3b as a general-purpose alt.
OLLAMA_MODEL=qwen2.5-coder:3b

# Where the local Ollama daemon is listening.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: point at a GitHub Enterprise Server API instead of public github.com.
# Default: https://api.github.com   (GHES example: https://github.example.com/api/v3)
# GITHUB_API_URL=

# Optional: a GitHub token raises API rate limits and allows reading private PRs/issues.
# Only used by the --pr / --repo-url modes. Inference never leaves your machine.
# To SUBMIT draft review comments from the Streamlit UI, the token must have Pull requests
# WRITE access (classic `repo` scope, or fine-grained Pull requests: Read and write).
# GITHUB_TOKEN=

# Optional: enables the research agent's web search. WHEN SET, issue/PR text is sent to
# Tavily (a third party). Leave unset to keep research GitHub-only (the local-only default).
# TAVILY_API_KEY=

# --- LangSmith tracing (OPT-IN; off by default for privacy) ---
# Tracing uploads prompts, the diff, and model outputs to LangSmith (an external service).
# It is forced OFF unless you set CODE_REVIEW_ENABLE_TRACING below — even if your shell
# already exports LANGCHAIN_TRACING_V2 / a key. To trace a run end to end:
#   CODE_REVIEW_ENABLE_TRACING=1
#   LANGSMITH_API_KEY=...                 # or LANGCHAIN_API_KEY
#   LANGCHAIN_PROJECT=code-review-agents  # optional; this is the default
# (The CLI's --trace flag sets CODE_REVIEW_ENABLE_TRACING=1 for you.)
# CODE_REVIEW_ENABLE_TRACING=
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=code-review-agents

# Belt-and-suspenders: keep these false so nothing leaks when not opted in.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
