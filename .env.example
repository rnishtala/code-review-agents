# Local Ollama model used by every agent. Default runs comfortably on an 8 GB MacBook Air.
# Upgrade to qwen2.5-coder:7b on 16 GB+ for higher quality, or llama3.2:3b as a general-purpose alt.
OLLAMA_MODEL=qwen2.5-coder:3b

# Where the local Ollama daemon is listening.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: a GitHub token raises API rate limits and allows reading private PRs.
# Only used by the --pr / --repo-url modes. Inference never leaves your machine.
# GITHUB_TOKEN=

# Keep LangChain/LangSmith tracing off so no data leaves your machine. The code
# defaults these to "false"; set to "true" only if you intentionally want tracing.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
